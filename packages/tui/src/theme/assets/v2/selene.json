{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["purple", "cyan", "green", "orange", "red"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.accent.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.accent.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.yellow.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.cyan.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "$hue.interactive.500",
          "$hovered": "$hue.interactive.400",
          "$focused": "$hue.interactive.600",
          "$selected": "$hue.interactive.500"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.600"
    },
    "scrollbar": {
      "base": "$hue.neutral.400"
    },
    "diff": {
      "text": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400",
        "context": "$hue.neutral.300",
        "hunkHeader": "$hue.neutral.300"
      },
      "background": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.green.300",
        "removed": "$hue.red.300"
      },
      "lineNumber": {
        "text": "$hue.neutral.300",
        "background": {
          "added": "$hue.green.700",
          "removed": "$hue.red.700"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.300",
      "keyword": "$hue.purple.400",
      "function": "$hue.cyan.400",
      "variable": "$hue.purple.200",
      "string": "$hue.green.400",
      "number": "$hue.yellow.400",
      "type": "$hue.cyan.300",
      "operator": "$hue.purple.300",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.purple.400",
      "link": "$hue.cyan.400",
      "linkText": "$hue.cyan.300",
      "code": "$hue.green.400",
      "blockQuote": "$hue.neutral.300",
      "emphasis": "$hue.purple.300",
      "strong": "$hue.yellow.400",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.purple.400",
      "listEnumeration": "$hue.cyan.400",
      "image": "$hue.cyan.400",
      "imageText": "$hue.cyan.300",
      "codeBlock": "$hue.neutral.100"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        }
      },
      "@footer": {
        "text": {
          "muted": "$hue.neutral.200"
        }
      }
    }
  },
