{
  "name": "selene",
  "displayName": "SELENE CODE",
  "description": "AI agent in the terminal: understands your project, writes code and runs commands.",
  "version": "0.1.3",
  "publisher": "naoriky",
  "author": {
    "name": "Naoriky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Naoriky-VFX/NAORIKY-SELENE"
  },
  "license": "MIT",
  "icon": "images/icon-orb-limpo.png",
  "galleryBanner": {
    "color": "#07070d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "agente",
    "terminal",
    "selene",
    "assistente",
    "codigo"
  ],
  "bugs": {
    "url": "https://github.com/Naoriky-VFX/NAORIKY-SELENE/issues"
  },
  "homepage": "https://github.com/Naoriky-VFX/NAORIKY-SELENE#readme",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "selene",
          "title": "SELENE",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "selene": [
        {
          "id": "selene.home",
          "name": "SELENE",
          "icon": "images/activity-icon.svg",
          "contextualTitle": "SELENE"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "selene.home",
        "contents": "SELENE CODE — AI coding agent in the terminal.\n[Open SELENE](command:selene.openTerminal)\n[Open in a new tab](command:selene.openNewTerminal)"
      }
    ],
    "commands": [
      {
        "command": "selene.openTerminal",
        "title": "Open SELENE",
        "category": "SELENE",
        "icon": "images/orb.png"
      },
      {
        "command": "selene.openNewTerminal",
        "title": "Open SELENE in a new tab",
        "category": "SELENE",
        "icon": "images/orb-plus.png"
      },
      {
        "command": "selene.install",
        "title": "Install or update the agent",
        "category": "SELENE",
        "icon": "images/orb.png"
      },
      {
        "command": "selene.addFilepathToTerminal",
        "title": "Insert file path into SELENE",
        "category": "SELENE"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "selene.openTerminal",
          "group": "navigation"
        },
        {
          "command": "selene.openNewTerminal",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "selene.openNewTerminal",
          "when": "view == selene.home",
          "group": "navigation"
        },
        {
          "command": "selene.install",
          "when": "view == selene.home",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "selene.openTerminal",
        "title": "Open SELENE",
        "key": "cmd+alt+escape",
        "mac": "cmd+alt+escape",
        "win": "ctrl+alt+escape",
        "linux": "ctrl+alt+escape"
      },
      {
        "command": "selene.openNewTerminal",
        "title": "Open SELENE in a new tab",
        "key": "cmd+alt+shift+escape",
        "mac": "cmd+alt+shift+escape",
        "win": "ctrl+alt+shift+escape",
        "linux": "ctrl+alt+shift+escape"
      },
      {
        "command": "selene.addFilepathToTerminal",
        "title": "SELENE: insert file reference",
        "key": "cmd+alt+s",
        "mac": "cmd+alt+s",
        "win": "ctrl+alt+s",
        "linux": "ctrl+alt+s"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
