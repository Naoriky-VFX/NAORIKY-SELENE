{
  "name": "selene",
  "displayName": "SELENE CODE",
  "description": "A SELENE no seu VS Code — o agente abre no terminal, ao lado do código.",
  "version": "0.1.1",
  "publisher": "naoriky",
  "repository": {
    "type": "git",
    "url": "https://github.com/Naoriky-VFX/NAORIKY-SELENE"
  },
  "license": "MIT",
  "icon": "images/icon-orb-limpo.png",
  "galleryBanner": {
    "color": "#07070d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "agente",
    "terminal",
    "selene",
    "assistente",
    "codigo"
  ],
  "bugs": {
    "url": "https://github.com/Naoriky-VFX/NAORIKY-SELENE/issues"
  },
  "homepage": "https://github.com/Naoriky-VFX/NAORIKY-SELENE#readme",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "selene.openTerminal",
        "title": "Abrir a SELENE",
        "category": "SELENE",
        "icon": {
          "light": "images/selene-orb-256.png",
          "dark": "images/selene-orb-glow.png"
        }
      },
      {
        "command": "selene.openNewTerminal",
        "title": "Abrir a SELENE em nova aba",
        "category": "SELENE",
        "icon": {
          "light": "images/selene-orb-256.png",
          "dark": "images/selene-orb-glow.png"
        }
      },
      {
        "command": "selene.install",
        "title": "Instalar ou atualizar o agente",
        "category": "SELENE",
        "icon": {
          "light": "images/selene-orb-256.png",
          "dark": "images/selene-orb-glow.png"
        }
      },
      {
        "command": "selene.addFilepathToTerminal",
        "title": "Inserir caminho do arquivo na SELENE",
        "category": "SELENE"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "selene.openNewTerminal",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "selene.openTerminal",
        "title": "Abrir a SELENE",
        "key": "cmd+alt+escape",
        "mac": "cmd+alt+escape",
        "win": "ctrl+alt+escape",
        "linux": "ctrl+alt+escape"
      },
      {
        "command": "selene.openNewTerminal",
        "title": "Abrir a SELENE em nova aba",
        "key": "cmd+alt+shift+escape",
        "mac": "cmd+alt+shift+escape",
        "win": "ctrl+alt+shift+escape",
        "linux": "ctrl+alt+shift+escape"
      },
      {
        "command": "selene.addFilepathToTerminal",
        "title": "SELENE: inserir arquivo mencionado",
        "key": "cmd+alt+s",
        "mac": "cmd+alt+s",
        "win": "ctrl+alt+s",
        "linux": "ctrl+alt+s"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
